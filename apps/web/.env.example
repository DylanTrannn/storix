# Local development only. For customer production, generate a fresh env set — see docs/DEPLOYMENT.md § "Customer handoff".
#
# API
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STORE_CURRENCY=VND

# R2 public URL for Next.js image optimization (same as API R2_PUBLIC_URL)
NEXT_PUBLIC_R2_PUBLIC_URL=

# Auth cookies (server-only)
ACCESS_TOKEN_COOKIE=storix_access_token
REFRESH_TOKEN_COOKIE=storix_refresh_token
