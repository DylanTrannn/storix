# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://storix:storix@localhost:5433/storix

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=15m

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:3000

# Cloudflare R2 (optional — required for product image uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=storix-media
R2_PUBLIC_URL=
R2_UPLOAD_MAX_BYTES=5242880
R2_ALLOWED_MIME=image/jpeg,image/png,image/webp,image/gif
